FROM node:22-alpine

RUN apk add --no-cache curl ca-certificates bash
RUN npm install -g openclaw@latest && npm cache clean --force
RUN mkdir -p /root/.openclaw/workspace

ENV NODE_ENV=production
ENV OPENCLAW_HOME=/root/.openclaw

EXPOSE 18789
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s CMD curl -f http://localhost:18789/ || exit 1

COPY openclaw-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
