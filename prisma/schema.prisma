// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role          String    @default("user") // "user" or "admin"

  // Stripe
  stripeCustomerId      String?   @unique

  // Relations
  accounts              Account[]
  sessions              Session[]
  organizations         Organization[] @relation("owner")
  organizationMembers   OrganizationMember[]
  workspaces            Workspace[]
  instances             Instance[]
  subscriptions         Subscription[]
  inferenceUsage        InferenceUsage[]
  creditBalance         CreditBalance?
  creditTransactions    CreditTransaction[]
  mediaJobs             MediaJob[]

  @@map("user")
}

// NextAuth Account
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

// Verification Token (for email verification, etc.)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

// Organization
model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members    OrganizationMember[]
  workspaces Workspace[]

  @@index([ownerId])
  @@map("organization")
}

// Organization Membership
model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // owner, admin, member
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_member")
}

// Workspace
model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  instances    Instance[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([ownerId])
  @@map("workspace")
}

// Subscription (Stripe-linked)
model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  tier                 String   @default("starter") // starter, pro, enterprise
  status               String   @default("incomplete") // incomplete, active, past_due, canceled, unpaid
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

// OpenClaw Agent Instance (one Docker container per instance)
model Instance {
  id             String   @id @default(cuid())
  workspaceId    String
  ownerId        String
  hermesAgentId  String?  // Docker container ID (set when running)
  status         String   @default("provisioning") // provisioning, running, stopped, error
  port           Int?     // Host port mapped to container's 18789
  pairingToken   String?  // Auto-approve token for device pairing
  apiKey         String?  @unique // External API key for this instance
  tier           String?  // Tier at time of provisioning
  modelPrimary   String?  // Primary model (e.g. anthropic/claude-sonnet-4-6)
  modelFallback  String?  // Fallback model
  name              String?  // User-given name for the agent
  telegramBotToken  String?  // Telegram bot token for this instance
  discordBotToken   String?  // Discord bot token for this instance
  slackBotToken     String?  // Slack bot token for this instance
  companionStatus   String   @default("unpaired") // 'unpaired' | 'paired' | 'offline'
  companionLastSeen DateTime? // last heartbeat from the paired local companion app
  delegationPolicy  String   @default("ask") // 'ask' | 'auto_trusted' | 'auto_all' | 'server_only'
  createdAt         DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  delegatedJobs DelegatedJob[]
  mediaJobs     MediaJob[]

  @@index([workspaceId])
  @@index([ownerId])
  @@unique([port])
  @@map("instance")
}

// Audit trail for actions the VPS sandbox delegated to a paired local
// companion app (installs, arbitrary exec, render jobs). See
// hermes-hybrid-companion-design.md section 5.
model DelegatedJob {
  id            String   @id @default(cuid())
  instanceId    String
  kind          String   // 'install_package' | 'run_command' | 'render_job'
  requestedAt   DateTime @default(now())
  status        String   @default("pending") // 'pending' | 'approved' | 'denied' | 'completed' | 'failed'
  approvedBy    String?  // user id, if a human approved it
  resultSummary String?
  payload       String?  // JSON-encoded request details (e.g. {"command": "pip install foo"})

  instance Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  mediaJob MediaJob?

  @@index([instanceId])
  @@map("delegated_job")
}

// Operator-controlled global switches (Step 7 narrow-beta safety net).
// Currently just the delegation kill switch: flipping it to true instantly
// blocks all new delegated-job creation and hides already-approved jobs
// from every companion heartbeat, across every instance, with no redeploy.
// Single row, fixed id "global". See hermes-hybrid-companion-design.md
// section 6 and the admin System Health page.
model SystemSetting {
  id                   String   @id @default("global")
  delegationKillSwitch Boolean  @default(false)
  updatedAt            DateTime @updatedAt
  updatedBy            String?

  @@map("system_setting")
}

// Discount / promo codes (managed by admins)
model DiscountCode {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  String   // "percentage" or "free"
  discountValue Int?     // percentage (e.g. 50 = 50% off), null for free
  maxUses       Int?     // null = unlimited
  currentUses   Int      @default(0)
  expiresAt     DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String   // admin user ID

  @@map("discount_code")
}

// Inference usage tracking (per user, per model)
model InferenceUsage {
  id        String   @id @default(cuid())
  userId    String
  model     String   // model identifier
  promptTokens   Int  @default(0)
  completionTokens Int @default(0)
  totalTokens     Int @default(0)
  costCents      Int? // cost in cents (optional)
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("inference_usage")
}

// Credit wallet -- one row per user. Spends on image/video generation,
// independent of subscription tier (see /topics/laverdi-saas media add-on
// scoping doc). balance is always the currently-spendable amount: a hold
// decrements it immediately, a refund increments it back, a charge is a
// no-op on balance (the hold already covered it).
model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_balance")
}

// Ledger of every credit movement -- purchase, monthly plan grant, a hold
// placed when a media job starts, its charge (finalize) or refund
// (release). amount is signed: positive credits the balance, negative
// debits it. A 'charge' row carries amount 0 -- it marks the matching
// 'hold' as consumed, it doesn't move the balance again.
model CreditTransaction {
  id                     String   @id @default(cuid())
  userId                 String
  creditBalanceId        String
  amount                 Int
  type                   String   // 'purchase' | 'grant' | 'hold' | 'charge' | 'refund'
  mediaJobId             String?
  stripePaymentIntentId  String?
  note                   String?
  createdAt              DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditBalance CreditBalance @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)
  mediaJob      MediaJob?     @relation(fields: [mediaJobId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([mediaJobId])
  @@map("credit_transaction")
}

// One row per image/video generation request. Images are delivered
// server-side (the provider's own URL is handed back to the agent, small
// enough not to bother storing). Video is delivered to the user's own
// machine via the companion app -- Vultr never stores or proxies the
// file -- see deliveryStatus below and the companion/jobs result route.
model MediaJob {
  id                       String    @id @default(cuid())
  instanceId               String
  userId                   String
  delegatedJobId           String?   @unique
  mediaKind                String    // 'image' | 'video'
  provider                 String    // 'fal'
  model                    String
  prompt                   String
  durationSeconds          Int?      // video only
  creditsHeld              Int
  creditsCharged           Int?
  status                   String    @default("pending") // pending|generating|awaiting_companion|delivered|failed|expired
  providerResultUrl        String?   // the PROVIDER's transient CDN link, never a Vultr-hosted one
  providerResultExpiresAt  DateTime?
  resultSummary            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  instance     Instance            @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  delegatedJob DelegatedJob?       @relation(fields: [delegatedJobId], references: [id])
  transactions CreditTransaction[]

  @@index([instanceId])
  @@index([userId])
  @@index([status, providerResultExpiresAt])
  @@map("media_job")
}
